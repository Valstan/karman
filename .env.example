# PostgreSQL connection.
# Локальная разработка (docker-compose):
DATABASE_URL=postgres://karman:karman@localhost:5432/karman_db
# Прод (сервер, unix-socket): postgres:///karman_db?host=/var/run/postgresql

# Секрет подписи сессий (JWT, HS256). ОБЯЗАТЕЛЕН в production — иначе сервис не стартует.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=change-me-in-production

# node env (development | production)
NODE_ENV=development

# Каталог хранения сканов документов (front_image/back_image/additional_files).
# Абсолютный путь; по умолчанию — `<cwd>/media` (на проде cwd = корень репо,
# каталог gitignored и переживает деплой). Файлы отдаются только через
# авторизованный /api/documents/[id]/file/[slot].
# MEDIA_ROOT=/home/valstan/karman/media

# Мастер-ключ менеджера секретов (AES-256-GCM). base64 от 32 байт.
# Сгенерировать: openssl rand -base64 32
# Хранится ТОЛЬКО в окружении сервера (никогда в БД/репо). Без него страница
# /secrets работает для создания проектов, но шифрование/выдача секретов отключены.
# Потеря ключа = невозможность расшифровать уже сохранённые секреты. См. docs/secrets-manager.md.
# SECRETS_MASTER_KEY=change-me-base64-32-bytes

# Provisioning-ключ vault: авторизует POST /api/secrets/provision — заведение комнаты
# проекта и выдачу ей ПЕРВОГО rw-токена (ADR-0006 §6, ADR-0010). Класс #008: это не
# skm_-токен комнаты и не мастер-MFA владельца, а отдельный секрет уровня «завести
# нового жильца». Без него роут отвечает 503 и self-serve онбординг просто выключен.
# Сгенерировать: openssl rand -base64 32
# Живёт только в окружении бокса (/etc/karman/karman.env). С волной 2 ADR-0012 это
# break-glass: штатный вход — паспорт CI (POST /api/secrets/session), а общий ключ
# остаётся единственным путём восстановления, если паспортный сломается.
# VAULT_PROVISION_KEY=change-me-base64-32-bytes

# Выключатель break-glass (ADR-0012 §7). Не задан или true — общий ключ работает
# как раньше; `false` — POST /api/secrets/provision отвечает 503 даже при заданном
# VAULT_PROVISION_KEY. Волна 5 ADR-0012 («выключение PROVISION_KEY_ENABLED») —
# это ровно одна эта переменная, без выкатки кода.
# PROVISION_KEY_ENABLED=true

# Срок жизни паспортной сессии в минутах (POST /api/secrets/session, ADR-0012 волна 2).
# По умолчанию 60; допустимый диапазон 5..720, значения вне него зажимаются.
# Сессия — обычный skm_-токен своей комнаты со сроком: клиенту волны 1 менять нечего,
# кроме строки, где он берёт токен. См. docs/passport-server.md.
# PASSPORT_SESSION_TTL_MINUTES=60

# Idle-таймаут keep-alive у HTTP-сервера, мс (G234). Задаётся не в коде, а переменной:
# standalone-сервер Next читает именно её. Ставить длиннее, чем keepalive прокси.
# На проде живёт в systemd-юните (scripts/karman.service), не в этом файле.
# KEEP_ALIVE_TIMEOUT=65000

# Шифрованный offsite-бэкап vault + media/ (scripts/backup_vault.sh, vault Ф4).
# Только на боксе; см. docs/secrets-vault-backup.md. НЕ в git.
#   BACKUP_GPG_RECIPIENT   — fingerprint/email публичного gpg-ключа владельца (импортирован в keyring)
#   YANDEX_WEBDAV_USER     — логин Яндекса
#   YANDEX_WEBDAV_PASSWORD — пароль ПРИЛОЖЕНИЯ Яндекса (не основной; при 2FA обязателен)
#   BACKUP_MEDIA_ROOT      — каталог сканов (по умолч. /home/valstan/karman/media)
#   BACKUP_WEBDAV_DIR      — папка на Диске (по умолч. /KARMAN-backups)
#   BACKUP_KEEP            — сколько последних бэкапов хранить (по умолч. 14)
# BACKUP_GPG_RECIPIENT=
# YANDEX_WEBDAV_USER=
# YANDEX_WEBDAV_PASSWORD=
